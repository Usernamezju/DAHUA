# All entries must be independently quantized INT8 ONNX classifiers.
evaluation_npz: ${CAMPUS6_EVAL_NPZ}
output_dir: ${CAMPUS6_INT8_ENSEMBLE_DIR}
models:
  - ctr_gcn=${CAMPUS6_CTR_INT8_ONNX}
  - protogcn=${CAMPUS6_PROTO_INT8_ONNX}
  - gap=${CAMPUS6_GAP_INT8_ONNX}
fusion: mean_softmax_probability
report: [single, all_pairs, three_way]
num_classes: 6
