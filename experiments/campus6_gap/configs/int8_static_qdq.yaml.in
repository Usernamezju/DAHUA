# Paths are supplied at execution time; calibration must contain TRAIN only.
fp32_onnx: ${CAMPUS6_FP32_ONNX}
calibration_npz: ${CAMPUS6_TRAIN_CALIBRATION_NPZ}
verification_npz: ${CAMPUS6_EVAL_NPZ}
int8_onnx: ${CAMPUS6_INT8_ONNX}
quantization: static_qdq
activation_type: uint8
weight_type: int8
per_channel: true
max_calibration_samples: 256
num_classes: 6
