# Full fine-tuning, not a frozen-text or frozen-backbone experiment.
work_dir: ${CAMPUS6_GAP_WORK_DIR}
weights: ${CAMPUS6_GAP_PRETRAINED}
ignore_weights: [fc, linear_head, part_list, logit_scale]
gap_prompt_bank: ${CAMPUS6_GAP_PROMPT_BANK}
feeder: feeders.feeder_ntu.Feeder
train_feeder_args:
  data_path: ${CAMPUS6_GAP_DATA}
  split: train
  window_size: 64
  random_rot: true
  p_interval: [0.5, 1]
  vel: false
  bone: false
test_feeder_args:
  data_path: ${CAMPUS6_GAP_DATA}
  split: val
  window_size: 64
  p_interval: [0.95]
  vel: false
  bone: false
model: model.ctrgcn.ModelGAP4Part
model_args:
  num_class: 6
  num_point: 25
  num_person: 2
  graph: graph.ntu_rgb_d.Graph
  graph_args: {labeling_mode: spatial}
  head: [ViT-B/32]
  k: 8
  drop_out: 0.2
use_language: true
loss_type: ce
loss_alpha: 0.8
te_lr_ratio: 1.0
amp: true
optimizer: SGD
base_lr: 0.003
weight_decay: 0.0005
nesterov: true
step: [30, 45]
lr_decay_rate: 0.1
warm_up_epoch: 3
num_epoch: 60
batch_size: 32
test_batch_size: 64
num_worker: 4
eval_interval: 5
save_interval: 5
seed: 2026
