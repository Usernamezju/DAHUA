# Source this file before launching the Campus6 Web service or a pose worker:
#   source configs/pose/rtmpose_fp16.env.example
#
# The model engines live in models/pose/fp16/ and are not interchangeable with
# the legacy .pth MMPose weights. Existing skeleton artifacts are untouched.
_DAHUA_FP16_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export DAHUA_CODE_ROOT="${DAHUA_CODE_ROOT:-${_DAHUA_FP16_ROOT}}"
export DAHUA_CAMPUS6_BACKEND="${DAHUA_CAMPUS6_BACKEND:-rtmpose17}"
export DAHUA_POSE_BACKEND="${DAHUA_POSE_BACKEND:-tensorrt_fp16}"
export DAHUA_POSE_DEVICE="${DAHUA_POSE_DEVICE:-cuda:0}"
export DAHUA_POSE_FP16_MODEL_ROOT="${DAHUA_POSE_FP16_MODEL_ROOT:-${DAHUA_CODE_ROOT}/models/pose/fp16}"

# Point this at the environment where mmdeploy_runtime and TensorRT are
# installed. The server reference is:
#   /workspace/code/envs/rtmpose_int8/bin/python
# export DAHUA_RTMPOSE_PYTHON="/path/to/rtmpose_int8/bin/python"

# Optional ABI-specific shared-library paths. Set these only when the target
# environment needs them; the server reference values are shown below.
# export DAHUA_TRT_LD_PRELOAD="/root/miniconda3/envs/rtmpose26/lib/libiomp5.so"
# export DAHUA_TRT_LD_LIBRARY_PATH="/workspace/code/envs/rtmpose_int8/lib/python3.8/site-packages/tensorrt_libs:/workspace/code/envs/rtmpose_int8/lib"

unset _DAHUA_FP16_ROOT
