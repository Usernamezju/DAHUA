{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teacher_output.v1",
  "type": "object",
  "required": ["schema_version", "sample_id", "label", "distribution", "confidence", "evidence", "counter_evidence", "reason", "needs_review"],
  "properties": {
    "schema_version": {"const": "teacher_output.v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "distribution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "probability"],
        "properties": {
          "label": {"type": "string"},
          "probability": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "segment_id", "description"],
        "properties": {
          "type": {"type": "string"},
          "segment_id": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "counter_evidence": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"},
    "needs_review": {"type": "boolean"}
  },
  "additionalProperties": false
}
