{
  "schema_version": "campus6.hosted_screening.v1",
  "target_per_class": 500,
  "minimum_rgb_per_class": 100,
  "minimum_combined_per_class": 500,
  "link_mode": "hardlink",
  "paths": {
    "repository_root": "/workspace/code/DAHUA",
    "input_root": "/workspace/data/xzz_data/DAHUA/datasets/campus6_candidates",
    "output_root": "/workspace/data/xzz_data/DAHUA/datasets/campus6_screened_gemini",
    "log_root": "/workspace/data/xzz_data/DAHUA/runtime/logs/dataset_construction"
  },
  "video_extensions": [".mp4", ".avi", ".mov", ".mkv", ".wmv", ".mpg", ".mpeg", ".webm"],
  "contact_sheets": {
    "total_frames": 20,
    "uniform_frames": 12,
    "motion_frames": 8,
    "scan_frames": 120,
    "frames_per_sheet": 4,
    "cell_width": 384,
    "cell_height": 256,
    "jpeg_quality": 90
  },
  "providers": {
    "primary": {
      "provider": "gemini",
      "model": "gemini-3.5-flash",
      "api_key_env": "GOOGLE_API_KEY",
      "prompt": "primary_audit_zh.txt",
      "max_tokens": 1800
    },
    "secondary": {
      "provider": "gemini",
      "model": "gemini-3.5-flash",
      "api_key_env": "GOOGLE_API_KEY",
      "prompt": "secondary_audit_zh.txt",
      "max_tokens": 1800
    },
    "adjudicator": {
      "provider": "gemini",
      "model": "gemini-3.5-flash",
      "api_key_env": "GOOGLE_API_KEY",
      "prompt": "adjudication_zh.txt",
      "max_tokens": 2000,
      "optional": true
    }
  },
  "request": {
    "timeout_seconds": 300,
    "max_attempts": 5,
    "initial_backoff_seconds": 5,
    "temperature": 0.0
  }
}
